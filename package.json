{
  "name": "code-connect-backend",
  "version": "1.0.0",
  "description": "Code Connect Backend using Express, Neon Postgres, and Vercel",
  "main": "api/index.js",
  "scripts": {
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node api/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "node api/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  }
}
